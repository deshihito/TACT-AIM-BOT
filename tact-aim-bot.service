[Unit]
Description=TACT-AIM Discord Bot (read-only TurboWarp cloud monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luna
WorkingDirectory=/home/luna/TACT-AIM-BOT
ExecStart=/home/luna/TACT-AIM-BOT/venv/bin/python bot.py
Restart=always
RestartSec=5
EnvironmentFile=/home/luna/TACT-AIM-BOT/.env

[Install]
WantedBy=multi-user.target
